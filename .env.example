# Copy to .env and fill in.

# Port the backend listens on (HTTP /api/history + WebSocket /ws).
PORT=8000

# Allowed CORS origin for the REST history endpoint (the frontend dev server).
CORS_ORIGIN=http://localhost:3000

# --- Auth (JWT) ---
# Secret used to sign JWTs. MUST be set to a long random string in production.
JWT_SECRET=
# Token lifetime in seconds (default 7 days).
JWT_EXPIRES_IN_SEC=604800

# --- Bootstrap admin (optional) ---
# When BOTH are set, the backend ensures an ADMIN user with this email exists on
# startup (creates it, or promotes an existing user of that email to ADMIN). Lets
# you provision an admin on a fresh deploy without the seed or a shell. The
# Register page only creates traders, so this is how you get an admin account.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# PostgreSQL connection for Prisma (leave blank to use the seeded in-memory users).
DATABASE_URL=

# Auto-seed demo data on a FRESH (empty) database at first boot. Set to 1 ONLY for
# a demo deploy — it creates well-known demo credentials (admin@demo.com /
# trader@demo.com / demo). Leave blank/unset in production. Once the DB has any
# account it never re-seeds (won't overwrite real data).
SEED_DEMO=

# --- Market-data model ---
# How market data is delivered (and licensed):
#   shared = Model A: one master DATABENTO_API_KEY, fanned out to all users
#   byo    = Model B: each user brings their own Databento account
#   dxfeed = dxLink WebSocket via Volumetrica/dxFeed (set DXFEED_* below)
# Default is "shared".
MARKET_DATA_MODE=shared

# --- dxFeed (when MARKET_DATA_MODE=dxfeed) ---
# Demo host works without auth for plumbing tests. Real futures need Volumetrica mint:
# DXFEED_AUTH_LOGIN / DXFEED_AUTH_PASSWORD / DXFEED_PLTF_KEY
# Optional static: DXFEED_ENDPOINT + DXFEED_TOKEN
# DXFEED_DEMO=0 to force dated CME symbols on a demo-looking host
# DXFEED_SYMBOL_MAP={"ES":"/ESU26:XCME"} optional JSON overrides
#
# Required gateway entitlements for all app symbols:
#   CME (ES/MES, NQ/MNQ), CBOT (YM/MYM), COMEX (GC/MGC), NYMEX (CL/MCL)
# Plus Candle/history entitlement for deep chart history (else live bars only).
# DXFEED_ENDPOINT=
# DXFEED_TOKEN=
# DXFEED_AUTH_URL=https://authdxfeed.volumetricatrading.com/api/v2/auth/token
# DXFEED_AUTH_LOGIN=
# DXFEED_AUTH_PASSWORD=
# DXFEED_PLTF_KEY=
# DXFEED_AUTH_ENVIRONMENT=1

# --- dxFeed Propfirm (onboarding market-data agreement) ---
# Use the same Propfirm x-api-key as SignalBackend (DXFEED_API_KEY).
# When set, Vault onboarding provisions a Volumetrica user and requires the
# trader to sign the data agreement before Complete.
# DXFEED_PROPFIRM_URL=https://dxfeed.volumetricaprop.com
# DXFEED_API_KEY=
# DXFEED_DATA_PRODUCTS=0
# DXFEED_PLATFORM=0
# DXFEED_DEFAULT_BALANCE=50000
# DXFEED_DEFAULT_RULE_ID=
# DXFEED_DEFAULT_COUNTRY=US
# Public Vault site origin — after signing the dxFeed agreement, traders are
# redirected here: {ONBOARDING_PUBLIC_URL}/onboarding?order=…&dxSigned=1
# Falls back to CORS_ORIGIN when that is an http(s) URL.
# ONBOARDING_PUBLIC_URL=https://enterthevault.co
# Point Volumetrica webhooks at: POST /api/dxfeed/webhook (header x-api-key)

# Secret used to ENCRYPT each user's stored Databento key at rest (Model B only).
# Any long random string. Required when MARKET_DATA_MODE=byo.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
MARKET_DATA_ENC_KEY=

# --- Databento ---
# Get a key at https://databento.com (Portal → API keys). Real-time CME data
# also requires a CME market-data subscription on your Databento account.
# Leave BLANK to run in simulation mode (random-walk prices, no account needed).
# Used by Model A (shared). Under Model B (byo) each user supplies their own key.
DATABENTO_API_KEY=

# CME Globex dataset. Do not change unless you know what you're doing.
DATABENTO_DATASET=GLBX.MDP3

# How often (ms) to poll the latest trade for each symbol (near-real-time).
QUOTE_POLL_MS=1500

# Backend market live console → Railway/API stdout (all symbols every N ms).
# MARKET_LIVE_CONSOLE=1
# MARKET_LIVE_CONSOLE_MS=15000
